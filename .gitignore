chroma/

# Observability
langfuse/

# Obsidian export: generated; keep only a committed sample (add it with git add -f)
exports/obsidian_vault/*
!exports/obsidian_vault/.gitkeep

# Reports are generated by the harness; keep the dir, ignore the outputs
reports/**/*.png
reports/**/*.html

# OS
.DS_Store

# Derived indexes (rebuild with `make ingest`)
data/index/
