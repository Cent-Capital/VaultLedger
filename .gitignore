# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Environments
.venv/
venv/
.env

# Secrets / keys
*.key

# Local data & generated artifacts (keep the dirs via .gitkeep)
data/synthetic_pdfs/*
!data/synthetic_pdfs/.gitkeep
*.sqlite
*.duckdb
