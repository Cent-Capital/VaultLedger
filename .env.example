# Copy to .env and fill in. Only needed for the cloud tiers (T2/T3);
# local mode (T0/T1 via Ollama) needs none of these and makes no network calls.
# .env is gitignored.

ANTHROPIC_API_KEY=        # T3 frontier + LLM-as-judge
MOONSHOT_API_KEY=         # T2 open-weight hosted: kimi-k2.6
OPENROUTER_API_KEY=       # T2 open-weight hosted: glm-5.2 (and fallback routing)
ZAI_API_KEY=              # T2 alternative provider for glm-5.2

# Optional observability (Phase 8). Leave blank to fall back to local RunManifests.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
